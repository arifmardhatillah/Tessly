{
  "name": "tessly",
  "version": "1.0.6",
  "description": "Tessly: AI Token Tracker. Know every token you spend.",
  "main": "src/main.js",
  "author": "Arif",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:scan": "node src/scan-cli.js",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "id.arif.tessly",
    "productName": "Tessly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "renderer/**",
      "build/icon.png",
      "build/tray.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Tessly"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arifmardhatillah",
        "repo": "Tessly",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
